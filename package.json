{
  "name": "visualized-deadline",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:life-controller && npm run test:sql:static",
    "test:sql:static": "node scripts/check-v2-migrations.mjs && node scripts/check-vercel-spa-routing.mjs",
    "test:life-controller": "tsc -p tests/tsconfig.life-controller.json && node --test tests/lifeController.test.mjs tests/executionDomain.test.mjs tests/homeProjection.test.mjs tests/v2Domain.test.mjs tests/v2Ranking.test.mjs tests/v2Backfill.test.mjs tests/dataSafety.test.mjs tests/authIdentity.test.mjs tests/smsBridgeContract.test.mjs tests/workspaceOwnership.test.mjs tests/appShell.test.mjs",
    "v2:backfill:local": "node scripts/v2-local-backfill.mjs",
    "v2:backfill:fixture": "node scripts/generate-v2-backfill-fixture.mjs",
    "test:v2:backfill:local": "node scripts/test-v2-local-backfill.mjs",
    "test:v2:guest-import:local": "node scripts/test-v2-guest-import-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@xyflow/react": "file:src/vendor/xyflow-react",
    "lucide-react": "^1.47.0",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
